# Otimizacao conservadora para Windows 10/11
# Execute como Administrador

Write-Host "Criando ponto de restauracao..." -ForegroundColor Cyan
try {
    Checkpoint-Computer -Description "Antes da otimizacao conservadora" -RestorePointType "MODIFY_SETTINGS"
    Write-Host "Ponto de restauracao criado." -ForegroundColor Green
} catch {
    Write-Host "Nao foi possivel criar ponto de restauracao. Pode ja existir um criado nas ultimas 24h ou a protecao do sistema pode estar desligada." -ForegroundColor Yellow
}

Write-Host "`nDesativando apps comuns de inicializacao automatica..." -ForegroundColor Cyan

$startupPaths = @(
    "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run",
    "HKLM:\Software\Microsoft\Windows\CurrentVersion\Run",
    "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run"
)

$blockList = @(
    "OneDrive",
    "Teams",
    "Microsoft Teams",
    "Skype",
    "Spotify",
    "Discord",
    "Steam",
    "EpicGamesLauncher",
    "Adobe",
    "AdobeAAMUpdater",
    "CCXProcess",
    "GoogleDrive",
    "Dropbox",
    "Telegram",
    "WhatsApp",
    "Zoom",
    "EdgeAutoLaunch",
    "Cortana"
)

foreach ($path in $startupPaths) {
    if (Test-Path $path) {
        $items = Get-ItemProperty -Path $path
        foreach ($name in $items.PSObject.Properties.Name) {
            foreach ($blocked in $blockList) {
                if ($name -like "*$blocked*") {
                    try {
                        Remove-ItemProperty -Path $path -Name $name -ErrorAction Stop
                        Write-Host "Removido da inicializacao: $name" -ForegroundColor Green
                    } catch {
                        Write-Host "Falha ao remover: $name" -ForegroundColor Yellow
                    }
                }
            }
        }
    }
}

Write-Host "`nRemovendo atalhos da pasta Inicializar..." -ForegroundColor Cyan

$startupFolders = @(
    "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup",
    "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\Startup"
)

foreach ($folder in $startupFolders) {
    if (Test-Path $folder) {
        Get-ChildItem $folder -ErrorAction SilentlyContinue | ForEach-Object {
            Write-Host "Removendo atalho de inicializacao: $($_.Name)" -ForegroundColor Green
            Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue
        }
    }
}

Write-Host "`nDesativando apps em segundo plano..." -ForegroundColor Cyan

New-Item -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" -Force | Out-Null
Set-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" -Name "GlobalUserDisabled" -Type DWord -Value 1

New-Item -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Search" -Force | Out-Null
Set-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Search" -Name "BackgroundAppGlobalToggle" -Type DWord -Value 0

Write-Host "`nRemovendo apps comuns desnecessarios..." -ForegroundColor Cyan

$appsToRemove = @(
    "*Microsoft.BingNews*",
    "*Microsoft.BingWeather*",
    "*Microsoft.GetHelp*",
    "*Microsoft.Getstarted*",
    "*Microsoft.MicrosoftOfficeHub*",
    "*Microsoft.MicrosoftSolitaireCollection*",
    "*Microsoft.People*",
    "*Microsoft.SkypeApp*",
    "*Microsoft.Todos*",
    "*Microsoft.WindowsFeedbackHub*",
    "*Microsoft.Xbox*",
    "*Microsoft.GamingApp*",
    "*Microsoft.ZuneMusic*",
    "*Microsoft.ZuneVideo*",
    "*Microsoft.MixedReality.Portal*",
    "*Clipchamp*",
    "*MicrosoftTeams*"
)

foreach ($app in $appsToRemove) {
    Get-AppxPackage -Name $app -AllUsers | ForEach-Object {
        try {
            Remove-AppxPackage -Package $_.PackageFullName -AllUsers -ErrorAction Stop
            Write-Host "Removido app instalado: $($_.Name)" -ForegroundColor Green
        } catch {
            Write-Host "Nao foi possivel remover app instalado: $($_.Name)" -ForegroundColor Yellow
        }
    }

    Get-AppxProvisionedPackage -Online | Where-Object DisplayName -like $app | ForEach-Object {
        try {
            Remove-AppxProvisionedPackage -Online -PackageName $_.PackageName -ErrorAction Stop | Out-Null
            Write-Host "Removido app provisionado: $($_.DisplayName)" -ForegroundColor Green
        } catch {
            Write-Host "Nao foi possivel remover app provisionado: $($_.DisplayName)" -ForegroundColor Yellow
        }
    }
}

Write-Host "`nDesativando sugestoes, propagandas e conteudo recomendado..." -ForegroundColor Cyan

$privacyKeys = @(
    "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager",
    "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced"
)

New-Item -Path $privacyKeys[0] -Force | Out-Null
Set-ItemProperty -Path $privacyKeys[0] -Name "ContentDeliveryAllowed" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "OemPreInstalledAppsEnabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "PreInstalledAppsEnabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "SilentInstalledAppsEnabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "SubscribedContent-338388Enabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "SubscribedContent-338389Enabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "SubscribedContent-353698Enabled" -Type DWord -Value 0
Set-ItemProperty -Path $privacyKeys[0] -Name "SystemPaneSuggestionsEnabled" -Type DWord -Value 0

New-Item -Path $privacyKeys[1] -Force | Out-Null
Set-ItemProperty -Path $privacyKeys[1] -Name "ShowSyncProviderNotifications" -Type DWord -Value 0

Write-Host "`nAjustando energia para desempenho..." -ForegroundColor Cyan

try {
    powercfg /setactive SCHEME_MIN
    Write-Host "Plano de energia ajustado para alto desempenho." -ForegroundColor Green
} catch {
    Write-Host "Nao foi possivel alterar o plano de energia." -ForegroundColor Yellow
}

Write-Host "`nLimpando arquivos temporarios..." -ForegroundColor Cyan

$tempPaths = @(
    "$env:TEMP\*",
    "C:\Windows\Temp\*"
)

foreach ($temp in $tempPaths) {
    Remove-Item $temp -Recurse -Force -ErrorAction SilentlyContinue
}

Write-Host "`nLimpando cache de DNS..." -ForegroundColor Cyan
ipconfig /flushdns | Out-Null

Write-Host "`nOtimizacao concluida. Reinicie o computador." -ForegroundColor Green
